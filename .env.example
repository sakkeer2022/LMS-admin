# Copy to .env.local for local development. Never commit .env.local.

# REQUIRED. Server-only: where /api/v1/* is proxied (next.config.ts rewrites). The browser always
# calls the same origin, so the backend needs no CORS entry for this app.
# Hosting (Vercel): set this in the project's Environment Variables for every environment and redeploy
# after changing it; the rewrite is fixed at build time. Use the backend's public https origin with
# no trailing slash and no /api/v1 (for QA, the Render URL).
BACKEND_ORIGIN=http://127.0.0.1:3000

# Server-only: must exactly match the backend JWT_SECRET (access tokens are verified here
# for route guards). At least 32 characters. Never prefix with NEXT_PUBLIC_.
JWT_SECRET=replace-with-backend-access-token-secret

# Multi-tenant routes deny access unless the signed tenantIds claim includes the URL tenant.
# The backend issues no tenantIds claim yet, so a single-tenant deployment names its one
# tenant here; a token without the claim may use only this tenant. Leave empty to fail closed.
# Locally: SINGLE_TENANT_ID=amentorz, then use /admin/amentorz/...
SINGLE_TENANT_ID=

# Offline UI preview login (username admin / password Admin@123). It never reaches the
# backend and every page shows "live data is unavailable". Works only under `next dev`.
# Keep false to use the real login.
NEXT_PUBLIC_ENABLE_DEV_ADMIN_LOGIN=false

# Browser tests only (npm run test:browser): path to a Playwright install and an optional
# browser channel (e.g. chrome). Playwright is not a dependency of this app.
PLAYWRIGHT_MODULE_PATH=
PLAYWRIGHT_CHANNEL=
