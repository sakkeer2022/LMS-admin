BACKEND_ORIGIN=http://127.0.0.1:3000
# Temporary frontend admin preview. Ignored outside next dev.
NEXT_PUBLIC_ENABLE_DEV_ADMIN_LOGIN=false
# Server-only: must exactly match backend JWT_SECRET. Never prefix with NEXT_PUBLIC_.
JWT_SECRET=replace-with-backend-access-token-secret
# Multi-tenant routes deny access unless signed tenantIds claim includes the URL tenant.
# Backend must first implement membership claims AND resource-level tenant isolation.
# Single-tenant deployments only: the tenant a token without a tenantIds claim may use.
# Leave empty to keep failing closed. The backend issues no tenantIds claim yet.
SINGLE_TENANT_ID=
